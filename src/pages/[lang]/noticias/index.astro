---
import BaseLayout from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import { getLocalePath } from '../../../i18n/translations';
import { areas } from '../../../data/areas.js';
import {
  getNewsPosts,
  getNewsAreaTags,
  getNewsAreaFilterTags,
  formatNewsDate,
} from '../../../data/news.js';

export function getStaticPaths() {
  return ['es', 'en', 'de'].map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

// Evita duplicados si alguna noticia está repetida por error en news.js
const posts = getNewsPosts().filter(
  (post, index, self) => self.findIndex((item) => item.slug === post.slug) === index
);

const usedAreaTags = getNewsAreaFilterTags();

const areaByTitle = new Map(areas.map((area) => [area.title.es, area]));
const filterAreas = areas.filter((area) => usedAreaTags.includes(area.title.es));

function getAreaLabel(tag) {
  const area = areaByTitle.get(tag);
  return area?.title?.[lang] || tag;
}

function getAreaIcon(tag) {
  const area = areaByTitle.get(tag);
  return area?.icon || 'M20 6 9 17l-5-5';
}

const copy = {
  es: {
    metaTitle: 'Noticias | Izquierdo y de la Cueva',
    metaDescription: 'Noticias, actualidad jurídica y artículos de Izquierdo y de la Cueva Abogados.',
    label: 'Noticias',
    title: 'Actualidad jurídica y novedades del despacho.',
    intro:
      'Artículos, comentarios legales y novedades relevantes para clientes, propietarios, empresas e inversores en Lanzarote.',
    search: 'Buscar noticia...',
    filterByArea: 'Filtrar por área',
    allAreas: 'Todas las áreas',
    readMore: 'Leer más',
    noResults: 'No hay noticias que coincidan con la búsqueda.',
    previous: 'Anterior',
    next: 'Siguiente',
  },
  en: {
    metaTitle: 'News | Izquierdo y de la Cueva',
    metaDescription: 'Legal news and articles from Izquierdo y de la Cueva Lawyers.',
    label: 'News',
    title: 'Legal updates and firm news.',
    intro:
      'Articles, legal commentary and relevant updates for clients, property owners, companies and investors in Lanzarote.',
    search: 'Search news...',
    filterByArea: 'Filter by area',
    allAreas: 'All areas',
    readMore: 'Read more',
    noResults: 'No news match your search.',
    previous: 'Previous',
    next: 'Next',
  },
  de: {
    metaTitle: 'News | Izquierdo y de la Cueva',
    metaDescription: 'Rechtliche Neuigkeiten und Artikel von Izquierdo y de la Cueva.',
    label: 'News',
    title: 'Rechtliche Aktualität und Kanzlei-News.',
    intro:
      'Artikel, rechtliche Kommentare und relevante Neuigkeiten für Mandanten, Eigentümer, Unternehmen und Investoren auf Lanzarote.',
    search: 'News suchen...',
    filterByArea: 'Nach Bereich filtern',
    allAreas: 'Alle Bereiche',
    readMore: 'Mehr lesen',
    noResults: 'Keine passenden Nachrichten gefunden.',
    previous: 'Zurück',
    next: 'Weiter',
  },
};

const t = copy[lang] || copy.es;
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  lang={lang}
>
  <PageHero
    label={t.label}
    title={t.title}
    intro={t.intro}
    image="https://images.unsplash.com/photo-1505664194779-8beaceb93744?auto=format&fit=crop&w=1800&q=80"
  />

  <section class="bg-[#F3F9FD] py-section text-ink">
    <div class="container-premium">
      <div class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <div>
          <span class="section-label text-brand-700">
            {t.filterByArea}
          </span>

          <h2 class="mt-5 text-[clamp(2.2rem,3.7vw,4.4rem)] leading-[0.96] tracking-[-0.075em]">
            {t.label}
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-[1fr_0.72fr]">
          <label class="block">
            <span class="sr-only">{t.search}</span>
            <input
              id="news-search"
              type="search"
              placeholder={t.search}
              class="w-full rounded-[18px] border border-black/10 bg-white px-6 py-4 text-[15px] text-ink outline-none transition focus:border-brand-700"
            />
          </label>

          <div class="news-area-dropdown relative">
            <button
              id="news-filter-button"
              type="button"
              class="flex w-full items-center justify-between gap-4 rounded-[18px] border border-black/10 bg-white px-5 py-4 text-left text-[14px] text-ink shadow-[0_12px_35px_rgba(17,17,17,.04)]"
              aria-expanded="false"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span id="news-filter-icon" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#EAF2F6] text-brand-700">
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </span>

                <span id="news-filter-label" class="truncate">
                  {t.allAreas}
                </span>
              </span>

              <span class="text-brand-700">⌄</span>
            </button>

            <div
              id="news-filter-menu"
              class="absolute right-0 top-[calc(100%+10px)] z-30 hidden max-h-[360px] w-full overflow-auto rounded-[18px] border border-black/10 bg-white p-2 shadow-[0_24px_80px_rgba(17,17,17,.14)]"
            >
              <button
                type="button"
                data-area-option
                data-area="all"
                data-label={t.allAreas}
                class="news-area-option active flex w-full items-center gap-3 rounded-[14px] px-4 py-3 text-left text-[14px] text-ink transition hover:bg-[#EAF2F6]"
              >
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#EAF2F6] text-brand-700">
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </span>

                <span>{t.allAreas}</span>
              </button>

              {filterAreas.map((area) => (
                <button
                  type="button"
                  data-area-option
                  data-area={area.title.es.toLowerCase()}
                  data-label={area.title?.[lang] || area.title.es}
                  class="news-area-option flex w-full items-center gap-3 rounded-[14px] px-4 py-3 text-left text-[14px] text-ink transition hover:bg-[#EAF2F6]"
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#EAF2F6] text-brand-700">
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={area.icon}></path>
                    </svg>
                  </span>

                  <span>{area.title?.[lang] || area.title.es}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div id="news-grid" class="grid auto-rows-fr grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {posts.map((post) => {
          const title = post.title?.[lang] || post.title?.es;
          const excerpt = post.excerpt?.[lang] || post.excerpt?.es;
          const postAreaTags = getNewsAreaTags(post);

          const searchableAreas = postAreaTags
            .map((tag) => getAreaLabel(tag))
            .join(' ');

          return (
            <article
              class="news-card flex h-full overflow-hidden rounded-[20px] border border-black/10 bg-white shadow-[0_18px_58px_rgba(17,17,17,.055)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_26px_76px_rgba(17,17,17,.11)]"
              data-title={`${title} ${excerpt} ${searchableAreas}`.toLowerCase()}
              data-areas={postAreaTags.join('|').toLowerCase()}
            >
              <a
                href={getLocalePath(`/noticias/${post.slug}/`, lang)}
                class="flex h-full w-full flex-col no-underline"
              >
                <div class="relative aspect-[16/8.4] shrink-0 overflow-hidden bg-[#06121C]">
                  <img
                    src={post.image}
                    alt={title}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 hover:scale-[1.04]"
                  />

                  <div class="absolute inset-0 bg-[#06121C]/10"></div>
                </div>

                <div class="flex flex-1 flex-col p-5">
                  <div class="flex flex-wrap items-center gap-2 text-[12px] text-muted">
                    <time datetime={post.date}>
                      {formatNewsDate(post.date, lang)}
                    </time>

                    <span class="h-1 w-1 rounded-full bg-muted/45"></span>

                    <span>{post.readTime}</span>
                  </div>

                  <h3 class="mt-4 min-h-[92px] text-[1.28rem] leading-tight tracking-[-0.055em] text-ink">
                    {title}
                  </h3>

                  <p class="mt-3 min-h-[48px] text-[14px] leading-relaxed text-muted">
                    {excerpt}
                  </p>

                  <div class="mt-5 flex min-h-[72px] flex-wrap content-start gap-2">
                    {postAreaTags.map((tag) => (
                      <span class="inline-flex items-center gap-2 rounded-full border border-[#9BAEC0]/45 px-3 py-1.5 text-[11.5px] text-[#5B6F8E]">
                        <svg
                          viewBox="0 0 24 24"
                          width="13"
                          height="13"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.65"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d={getAreaIcon(tag)}></path>
                        </svg>

                        <span>{getAreaLabel(tag)}</span>
                      </span>
                    ))}
                  </div>

                  <span class="mt-auto inline-flex w-full items-center justify-center bg-[#0D2A3E] px-5 py-3 text-[11px] uppercase tracking-[0.18em] text-white transition hover:bg-[#216287]">
                    {t.readMore}
                  </span>
                </div>
              </a>
            </article>
          );
        })}
      </div>

      <p id="news-empty" class="mt-12 hidden text-[18px] text-muted">
        {t.noResults}
      </p>

      <div id="news-pagination" class="mt-12 flex items-center justify-center gap-4">
        <button
          id="news-prev"
          type="button"
          class="rounded-full border border-black/10 bg-white px-5 py-3 text-[12px] uppercase tracking-[0.18em] text-ink/70 transition hover:border-brand-700 hover:text-brand-700 disabled:cursor-not-allowed disabled:opacity-35"
        >
          {t.previous}
        </button>

        <span id="news-page-info" class="text-[13px] uppercase tracking-[0.18em] text-muted">
          1 / 1
        </span>

        <button
          id="news-next"
          type="button"
          class="rounded-full border border-black/10 bg-white px-5 py-3 text-[12px] uppercase tracking-[0.18em] text-ink/70 transition hover:border-brand-700 hover:text-brand-700 disabled:cursor-not-allowed disabled:opacity-35"
        >
          {t.next}
        </button>
      </div>
    </div>
  </section>

  <CTASection lang={lang} />
</BaseLayout>

<style>
  .news-area-option.active {
    background: #216287;
    color: white;
  }

  .news-area-option.active span:first-child {
    background: rgba(255, 255, 255, 0.14);
    color: white;
  }

  .news-card h3,
  .news-card p {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
  }

  .news-card h3 {
    -webkit-line-clamp: 4;
  }

  .news-card p {
    -webkit-line-clamp: 2;
  }
</style>

<script>
  const PAGE_SIZE = 8;

  const searchInput = document.getElementById('news-search');
  const cards = [...document.querySelectorAll('.news-card')];
  const empty = document.getElementById('news-empty');

  const filterButton = document.getElementById('news-filter-button');
  const filterMenu = document.getElementById('news-filter-menu');
  const filterLabel = document.getElementById('news-filter-label');
  const filterIcon = document.getElementById('news-filter-icon');
  const areaOptions = [...document.querySelectorAll('[data-area-option]')];

  const pagination = document.getElementById('news-pagination');
  const prevButton = document.getElementById('news-prev');
  const nextButton = document.getElementById('news-next');
  const pageInfo = document.getElementById('news-page-info');

  let activeArea = 'all';
  let currentPage = 1;

  function getMatchingCards() {
    const query = (searchInput?.value || '').trim().toLowerCase();

    return cards.filter((card) => {
      const title = card.dataset.title || '';
      const areas = card.dataset.areas || '';

      const matchesQuery = !query || title.includes(query) || areas.includes(query);
      const matchesArea = activeArea === 'all' || areas.includes(activeArea);

      return matchesQuery && matchesArea;
    });
  }

  function updateNews() {
    const matchingCards = getMatchingCards();
    const totalPages = Math.max(1, Math.ceil(matchingCards.length / PAGE_SIZE));

    if (currentPage > totalPages) currentPage = totalPages;

    cards.forEach((card) => card.classList.add('hidden'));

    const start = (currentPage - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;

    matchingCards.slice(start, end).forEach((card) => {
      card.classList.remove('hidden');
    });

    empty?.classList.toggle('hidden', matchingCards.length !== 0);
    pagination?.classList.toggle('hidden', matchingCards.length <= PAGE_SIZE);

    if (pageInfo) pageInfo.textContent = `${currentPage} / ${totalPages}`;
    if (prevButton) prevButton.disabled = currentPage <= 1;
    if (nextButton) nextButton.disabled = currentPage >= totalPages;
  }

  function closeFilterMenu() {
    filterMenu?.classList.add('hidden');
    filterButton?.setAttribute('aria-expanded', 'false');
  }

  filterButton?.addEventListener('click', () => {
    filterMenu?.classList.toggle('hidden');

    const isOpen = !filterMenu?.classList.contains('hidden');
    filterButton.setAttribute('aria-expanded', String(isOpen));
  });

  areaOptions.forEach((button) => {
    button.addEventListener('click', () => {
      activeArea = button.dataset.area || 'all';
      currentPage = 1;

      areaOptions.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');

      if (filterLabel) filterLabel.textContent = button.dataset.label || '';

      if (filterIcon) {
        const icon = button.querySelector('svg');
        if (icon) filterIcon.innerHTML = icon.outerHTML;
      }

      closeFilterMenu();
      updateNews();
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    const dropdown = document.querySelector('.news-area-dropdown');

    if (dropdown && !dropdown.contains(target)) {
      closeFilterMenu();
    }
  });

  searchInput?.addEventListener('input', () => {
    currentPage = 1;
    updateNews();
  });

  prevButton?.addEventListener('click', () => {
    currentPage -= 1;
    updateNews();
  });

  nextButton?.addEventListener('click', () => {
    currentPage += 1;
    updateNews();
  });

  updateNews();
</script>