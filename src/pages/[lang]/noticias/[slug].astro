---
import BaseLayout from '../../../layouts/Base.astro';
import CTASection from '../../../components/CTASection.astro';
import { getLocalePath } from '../../../i18n/translations';
import { areas } from '../../../data/areas.js';
import {
  getNewsPosts,
  getNewsSlugs,
  getNewsBySlug,
  getNewsAreaTags,
  formatNewsDate,
} from '../../../data/news.js';

export function getStaticPaths() {
  return ['es', 'en', 'de'].flatMap((lang) =>
    getNewsSlugs().map((slug) => ({
      params: { lang, slug },
      props: {
        lang,
        post: getNewsBySlug(slug),
      },
    }))
  );
}

const { lang, post } = Astro.props;

const title = post.title?.[lang] || post.title?.es;
const excerpt = post.excerpt?.[lang] || post.excerpt?.es;
const content = post.content?.[lang] || post.content?.es || [];

const areaTags = getNewsAreaTags(post);

const areaByTitle = new Map(areas.map((area) => [area.title.es, area]));

function getAreaLabel(tag) {
  const area = areaByTitle.get(tag);
  return area?.title?.[lang] || tag;
}

function getAreaIcon(tag) {
  const area = areaByTitle.get(tag);
  return area?.icon || 'M20 6 9 17l-5-5';
}

const labels = {
  es: {
    back: 'Volver a noticias',
    related: 'Más entradas',
    readMore: 'Leer más',
    published: 'Publicado',
  },
  en: {
    back: 'Back to news',
    related: 'More posts',
    readMore: 'Read more',
    published: 'Published',
  },
  de: {
    back: 'Zurück zu News',
    related: 'Weitere Beiträge',
    readMore: 'Mehr lesen',
    published: 'Veröffentlicht',
  },
};

const l = labels[lang] || labels.es;

const relatedPosts = getNewsPosts()
  .filter((item) => item.slug !== post.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${title} | Izquierdo y de la Cueva`}
  description={excerpt}
  lang={lang}
>
  <section class="news-hero relative flex min-h-[64vh] items-end overflow-hidden bg-[#06121C] text-white">
    <img
      src={post.image}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover object-center"
    />

    <div class="absolute inset-0 bg-[linear-gradient(115deg,rgba(3,8,13,.95)_0%,rgba(8,28,43,.88)_45%,rgba(33,98,135,.42)_100%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#06121C]/42 via-transparent to-[#06121C]/70"></div>

    <div class="relative z-10 w-full">
      <div class="container-premium">
        <div class="news-hero-content pb-14 pt-32 md:pb-16 md:pt-36">
          <a
            href={getLocalePath('/noticias/', lang)}
            class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[0.24em] text-white/62 no-underline transition-colors hover:text-white"
          >
            ← {l.back}
          </a>

          <div class="mt-9 flex flex-wrap items-center gap-3 text-[13px] text-white/68">
            <span>{l.published}: {formatNewsDate(post.date, lang)}</span>
            <span class="h-1 w-1 rounded-full bg-white/45"></span>
            <span>{post.readTime}</span>
          </div>

          <h1 class="news-hero-title mt-5 text-white">
            {title}
          </h1>

          <p class="mt-7 max-w-3xl text-[17px] leading-relaxed text-white/74 md:text-[19px]">
            {excerpt}
          </p>

          <div class="mt-8 flex flex-wrap gap-2">
            {areaTags.map((tag) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-[12px] text-white/86 backdrop-blur-sm">
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={getAreaIcon(tag)}></path>
                </svg>

                <span>{getAreaLabel(tag)}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-section text-ink">
    <div class="container-premium">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.78fr)_0.22fr] lg:gap-16">
        <article class="news-content max-w-4xl">
          {content.map((block) => (
            block.type === 'paragraph' ? (
              <p>{block.text}</p>
            ) : block.type === 'heading' ? (
              <h2>{block.text}</h2>
            ) : block.type === 'list' ? (
              <ul>
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : null
          ))}
        </article>

        <aside class="hidden lg:block">
          <div class="sticky top-28 rounded-[22px] bg-[#EAF2F6] p-7">
            <span class="section-label text-brand-700">
              {l.related}
            </span>

            <div class="mt-6 space-y-5">
              {relatedPosts.map((item) => {
                const relatedTitle = item.title?.[lang] || item.title?.es;

                return (
                  <a
                    href={getLocalePath(`/noticias/${item.slug}/`, lang)}
                    class="block border-b border-[#0D2A3E]/12 pb-5 text-ink no-underline last:border-b-0 last:pb-0 hover:text-brand-700"
                  >
                    <time class="text-[12px] text-muted">
                      {formatNewsDate(item.date, lang)}
                    </time>

                    <strong class="mt-2 block text-[1.05rem] leading-tight tracking-[-0.035em]">
                      {relatedTitle}
                    </strong>
                  </a>
                );
              })}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[#F3F9FD] py-section text-ink">
    <div class="container-premium">
      <div class="mb-10 flex items-end justify-between gap-6">
        <div>
          <span class="section-label text-brand-700">
            {l.related}
          </span>

          <h2 class="mt-5 text-[clamp(2.3rem,4vw,4.6rem)] leading-[0.95] tracking-[-0.075em]">
            {l.related}
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-7 md:grid-cols-3">
        {relatedPosts.map((item) => {
          const itemTitle = item.title?.[lang] || item.title?.es;
          const itemExcerpt = item.excerpt?.[lang] || item.excerpt?.es;
          const itemAreaTags = getNewsAreaTags(item);

          return (
            <article class="overflow-hidden rounded-[22px] border border-black/10 bg-white shadow-[0_22px_70px_rgba(17,17,17,.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_30px_90px_rgba(17,17,17,.12)]">
              <a href={getLocalePath(`/noticias/${item.slug}/`, lang)} class="block no-underline">
                <div class="relative aspect-[16/9] overflow-hidden bg-[#06121C]">
                  <img
                    src={item.image}
                    alt={itemTitle}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 hover:scale-[1.04]"
                  />

                  <div class="absolute inset-0 bg-[#06121C]/10"></div>
                </div>

                <div class="p-6">
                  <time class="text-[13px] text-muted">
                    {formatNewsDate(item.date, lang)}
                  </time>

                  <h3 class="mt-4 text-[1.35rem] leading-tight tracking-[-0.055em] text-ink">
                    {itemTitle}
                  </h3>

                  <p class="mt-3 line-clamp-3 text-[14.5px] leading-relaxed text-muted">
                    {itemExcerpt}
                  </p>

                  <div class="mt-5 flex flex-wrap gap-2">
                    {itemAreaTags.map((tag) => (
                      <span class="inline-flex items-center gap-2 rounded-full border border-[#9BAEC0]/45 px-3 py-1.5 text-[11.5px] text-[#5B6F8E]">
                        <svg
                          viewBox="0 0 24 24"
                          width="13"
                          height="13"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.65"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d={getAreaIcon(tag)}></path>
                        </svg>

                        <span>{getAreaLabel(tag)}</span>
                      </span>
                    ))}
                  </div>

                  <span class="mt-6 inline-flex w-full items-center justify-center bg-[#34483F] px-5 py-3.5 text-[12px] uppercase tracking-[0.18em] text-white transition hover:bg-[#216287]">
                    {l.readMore}
                  </span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTASection lang={lang} />
</BaseLayout>

<style>
  .news-hero-content {
    width: 100%;
    max-width: 1040px;
    margin-left: 0;
    text-align: left;
  }

  .news-hero-title {
    max-width: 1040px;
    font-size: clamp(3rem, 5.9vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .news-content {
    font-size: 1.08rem;
    line-height: 1.82;
    color: rgba(31, 42, 68, 0.78);
  }

  .news-content p {
    margin: 0 0 1.5rem;
  }

  .news-content h2 {
    margin: 3rem 0 1.2rem;
    font-size: clamp(2rem, 3vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: #1f2a44;
  }

  .news-content ul {
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .news-content li {
    position: relative;
    padding-left: 2rem;
  }

  .news-content li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.55rem;
    height: 0.55rem;
    background: #216287;
    border-radius: 999px;
  }

  @media (max-width: 767px) {
    .news-hero {
      min-height: auto;
    }

    .news-hero-content {
      max-width: 100%;
      padding-top: 8.75rem;
      padding-bottom: 3.75rem;
    }

    .news-hero-title {
      font-size: clamp(2.45rem, 11vw, 4.2rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
    }
  }
</style>