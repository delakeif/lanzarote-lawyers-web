---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import CTASection from '../../components/CTASection.astro';

export const prerender = true;
---

<Base title="Contactar — Izquierdo y de la Cueva" description="Contacta con nuestro despacho de abogados en Lanzarote. Formulario de consulta, oficinas en Arrecife y Playa Blanca.">
  <!-- Page header -->
  <section class="bg-navy-500 pt-32 pb-20">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <span class="section-label text-gold-400/60">Contactar</span>
      <div class="w-12 h-px bg-gold-400/40 mt-4 mb-6"></div>
      <h1 class="font-display text-hero text-cream max-w-2xl">Contactar</h1>
    </div>
  </section>

  <ContactForm lang="es" />

  <!-- Map / Offices -->
  <section class="bg-white py-section">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="font-display text-heading text-navy-500 mb-12">Nuestras oficinas</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h3 class="font-display text-lg font-semibold text-navy-500 mb-3">Arrecife</h3>
          <p class="text-navy-300 text-sm leading-relaxed mb-2">Centro de Arrecife, Lanzarote</p>
          <p class="text-navy-300 text-sm">Tel: <a href="tel:+34928801056" class="text-gold-500">+34 928 801 056</a></p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-navy-500 mb-3">Playa Blanca</h3>
          <p class="text-navy-300 text-sm leading-relaxed mb-2">Playa Blanca, Yaiza, Lanzarote</p>
          <p class="text-navy-300 text-sm">Tel: <a href="tel:+34928801056" class="text-gold-500">+34 928 801 056</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
