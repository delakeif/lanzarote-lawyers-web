---
import Base from '../../../layouts/Base.astro';
import { getLocalePath } from '../../../i18n/translations';
import { areas } from '../../../data/areas.js';

export const prerender = true;

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const lang = 'de';
---

<Base
  title={`${area.title[lang]} — Anwälte auf Lanzarote | Izquierdo y de la Cueva`}
  description={`${area.summary[lang]} Mehrsprachige Anwaltskanzlei auf Lanzarote mit über 40 Jahren Erfahrung.`}
>
  <!-- Hero con gradiente oscuro para legibilidad -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src={area.image} alt="" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/45"></div>
    </div>
    <div class="relative container-premium pt-36 pb-20 md:pt-44 md:pb-28">
      <a href={getLocalePath('/areas/', lang)} class="inline-flex items-center gap-2 text-white/50 text-xs uppercase tracking-[0.22em] no-underline hover:text-white/80 transition-colors mb-8">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
        Rechtsgebiete
      </a>
      <div class="flex items-start gap-6">
        <div class="hidden md:flex h-16 w-16 items-center justify-center border border-white/25 text-white/80 shrink-0 mt-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><path d={area.icon}></path></svg>
        </div>
        <div>
          <h1 class="text-heading text-white">{area.title[lang]}</h1>
          <p class="mt-5 text-lg md:text-xl text-white/65 max-w-3xl leading-relaxed">{area.summary[lang]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Über dieses Rechtsgebiet — texto izquierda, bloque visual derecha -->
  <section class="bg-white py-section">
    <div class="container-premium">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
        <div class="lg:col-span-7" data-animate>
          <span class="section-label">Über dieses Rechtsgebiet</span>
          <div class="w-12 h-px bg-brand-500 mt-4 mb-8"></div>
          <p class="text-[17px] md:text-[19px] text-ink/80 leading-[1.75]">{area.intro[lang]}</p>
          <a href={getLocalePath('/contactar/', lang)} class="btn-primary mt-10">Beratung anfordern</a>
        </div>

        <!-- Bloque visual: foto vertical con overlay de datos -->
        <div class="lg:col-span-5 hidden lg:block" data-animate>
          <div class="relative">
            <img src={area.image} alt="" class="w-full aspect-[4/5] object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-900/90 via-brand-900/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8">
              <div class="flex items-end gap-4">
                <span class="text-[72px] leading-none font-display text-white/90 tracking-tighter">40<sup class="text-brand-300 text-3xl">+</sup></span>
                <div class="pb-2">
                  <p class="text-white/60 text-sm leading-tight">Jahre Erfahrung<br/>auf Lanzarote</p>
                </div>
              </div>
              <div class="w-12 h-px bg-brand-400/40 mt-5 mb-4"></div>
              <p class="text-white/40 text-xs uppercase tracking-[0.3em]">Seit 1986 · Arrecife · Playa Blanca</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios — fondo azul corporativo, imagen izq, acordeón der -->
  <section class="bg-brand-900 py-section">
    <div class="container-premium">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <!-- Imagen lateral -->
        <div class="lg:col-span-4 hidden lg:block" data-animate>
          <div class="sticky top-32">
            <img src={area.image} alt={area.title[lang]} class="w-full aspect-[3/4] object-cover" loading="lazy" />
          </div>
        </div>

        <!-- Acordeón -->
        <div class="lg:col-span-8" data-animate>
          <span class="text-[11px] uppercase tracking-[0.36em] text-brand-300/50">Leistungen</span>
          <h2 class="text-[clamp(2rem,4vw,3.8rem)] leading-[0.95] tracking-[-0.065em] text-white mt-5 mb-12">Wie wir Ihnen helfen können</h2>
          <div class="space-y-4">
            {area.services.map((service, i) => (
              <details class="service-accordion group border border-white/8 bg-white/[0.03]">
                <summary class="flex items-center gap-5 px-7 py-6 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                  <span class="shrink-0 w-10 h-10 flex items-center justify-center text-[13px] tracking-wider text-brand-300 border border-brand-400/20 rounded-full transition-colors duration-300 group-open:bg-brand-500 group-open:text-white group-open:border-brand-500">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="text-[18px] md:text-[20px] tracking-[-0.03em] text-white/90 flex-1 pr-4">{service.title[lang]}</h3>
                  <svg class="w-5 h-5 text-white/25 shrink-0 transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </summary>
                <div class="px-7 pb-7 pt-2 ml-[60px]">
                  <p class="text-[16px] text-white/50 leading-[1.75]">{service.detail[lang]}</p>
                  <a href={getLocalePath('/contactar/', lang)} class="inline-flex items-center gap-2 mt-6 text-brand-300 text-[13px] uppercase tracking-[0.18em] no-underline hover:text-white transition-colors">
                    Hierzu anfragen
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
                  </a>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-white py-section">
    <div class="container-premium">
      <div class="max-w-3xl mx-auto text-center" data-animate>
        <h2 class="text-[clamp(2rem,4vw,3.8rem)] leading-[0.95] tracking-[-0.065em] text-ink">Fragen zu {area.title[lang].toLowerCase()}?</h2>
        <p class="mt-6 text-lg text-muted leading-relaxed max-w-2xl mx-auto">Schildern Sie uns Ihre Situation. Wir erklären Ihnen Ihre Möglichkeiten klar und unverbindlich.</p>
        <div class="flex flex-wrap justify-center gap-4 mt-10">
          <a href={getLocalePath('/contactar/', lang)} class="btn-primary">Kanzlei kontaktieren</a>
          <a href="tel:+34928801056" class="btn-outline">+34 928 801 056</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .service-accordion { transition: border-color 0.3s ease; }
  .service-accordion[open] { border-color: rgba(33, 98, 135, 0.4); }
  .service-accordion summary { transition: background-color 0.2s ease; }
  .service-accordion summary:hover { background-color: rgba(255, 255, 255, 0.04); }
</style>
