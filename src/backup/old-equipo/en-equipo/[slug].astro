---
import Base from '../../../layouts/Base.astro';
import { getLocalePath } from '../../../i18n/translations';
import { team } from '../../../data/team.js';

export const prerender = true;

export function getStaticPaths() {
  return team.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;
const lang = 'en';

const labels = {
  es: { back: 'Equipo', about: 'Sobre', specialties: 'Áreas de especialización', languages: 'Idiomas', contact: 'Contacto', email: 'Escribir email', cta: 'Solicitar consulta', ctaText: '¿Quieres que tu caso lo lleve nuestro equipo?', phone: '+34 928 801 056' },
  en: { back: 'Team', about: 'About', specialties: 'Areas of specialisation', languages: 'Languages', contact: 'Contact', email: 'Send email', cta: 'Request a consultation', ctaText: 'Want our team to handle your case?', phone: '+34 928 801 056' },
  de: { back: 'Team', about: 'Über', specialties: 'Fachgebiete', languages: 'Sprachen', contact: 'Kontakt', email: 'E-Mail senden', cta: 'Beratung anfordern', ctaText: 'Möchten Sie, dass unser Team Ihren Fall übernimmt?', phone: '+34 928 801 056' },
};
const l = labels[lang];
---

<Base
  title={`${member.name} — ${member.role[lang]} | Izquierdo y de la Cueva`}
  description={`${member.name}, ${member.role[lang]} en Izquierdo y de la Cueva. Abogados multilingües en Lanzarote.`}
>
  <!-- Hero con foto -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-900 via-brand-900/95 to-brand-900/70"></div>
    <div class="relative container-premium pt-36 pb-16 md:pt-44 md:pb-20">
      <a href={getLocalePath('/equipo/', lang)} class="inline-flex items-center gap-2 text-white/50 text-xs uppercase tracking-[0.22em] no-underline hover:text-white/80 transition-colors mb-10">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
        {l.back}
      </a>
    </div>
  </section>

  <!-- Contenido principal -->
  <section class="bg-white">
    <div class="container-premium">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 -mt-20 md:-mt-28">

        <!-- Foto -->
        <div class="lg:col-span-4" data-animate>
          <div class="relative">
            <div class="aspect-[3/4] bg-brand-900 overflow-hidden">
              <img
                src={member.photo}
                alt={member.name}
                class="w-full h-full object-cover"
                loading="eager"
                onerror="this.style.display='none';this.parentElement.classList.add('bg-gradient-to-br','from-brand-700','to-brand-900');this.parentElement.innerHTML+='<div class=\'flex items-center justify-center h-full\'><span class=\'text-6xl text-white/20 font-display\'>' + member.name.split(' ').map(n=>n[0]).join('') + '</span></div>'"
              />
            </div>
          </div>

          <!-- Datos rápidos bajo la foto -->
          <div class="mt-6 space-y-5">
            <div>
              <span class="text-[11px] uppercase tracking-[0.36em] text-muted">{l.languages}</span>
              <div class="flex flex-wrap gap-2 mt-2">
                {member.languages.map(lng => (
                  <span class="text-sm text-ink/70 px-3 py-1 bg-brand-50 border border-brand-100">{lng}</span>
                ))}
              </div>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.36em] text-muted">{l.contact}</span>
              <div class="mt-2">
                <a href={`mailto:${member.email}`} class="inline-flex items-center gap-2 text-brand-500 text-sm no-underline hover:text-brand-700 transition-colors">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  {member.email}
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Bio y especialidades -->
        <div class="lg:col-span-8 pt-8 lg:pt-12" data-animate>
          <span class="section-label">{member.role[lang]}</span>
          <h1 class="text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.95] tracking-[-0.065em] text-ink mt-4">
            {member.name}
          </h1>

          <!-- Bio -->
          <div class="mt-10">
            <span class="text-[11px] uppercase tracking-[0.36em] text-muted">{l.about}</span>
            <div class="w-12 h-px bg-brand-500 mt-4 mb-6"></div>
            <p class="text-[17px] text-ink/75 leading-[1.8]">
              {member.bio[lang]}
            </p>
          </div>

          <!-- Especialidades -->
          <div class="mt-12">
            <span class="text-[11px] uppercase tracking-[0.36em] text-muted">{l.specialties}</span>
            <div class="w-12 h-px bg-brand-500 mt-4 mb-6"></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {member.specialties[lang].map(spec => (
                <div class="flex items-center gap-4 p-4 border border-black/6 hover:border-brand-500/30 transition-colors">
                  <div class="w-2 h-2 rounded-full bg-[#2596be] shrink-0"></div>
                  <span class="text-[15px] text-ink/80">{spec}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA -->
          <div class="mt-14 p-8 bg-brand-900 text-white">
            <h3 class="text-xl tracking-[-0.03em]">{l.ctaText}</h3>
            <div class="flex flex-wrap gap-4 mt-6">
              <a href={getLocalePath('/contactar/', lang)} class="btn-outline-light">{l.cta}</a>
              <a href={`tel:${l.phone}`} class="inline-flex items-center gap-2 text-white/50 text-sm no-underline hover:text-white transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {l.phone}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="h-section bg-white"></div>
</Base>
