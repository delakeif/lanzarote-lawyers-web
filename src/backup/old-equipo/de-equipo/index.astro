---
import Base from '../../../layouts/Base.astro';
import CTASection from '../../../components/CTASection.astro';
import { getLocalePath } from '../../../i18n/translations';
import { team, getLawyers, getStaff } from '../../../data/team.js';

export const prerender = true;

const lang = 'de';
const lawyers = getLawyers();
const staff = getStaff();

const labels = {
  es: { title: 'Nuestro equipo', subtitle: 'Profesionales con experiencia, dedicación y un trato cercano.', lawyers: 'Abogados', staff: 'Equipo de apoyo', viewProfile: 'Ver perfil' },
  en: { title: 'Our Team', subtitle: 'Professionals with experience, dedication and a personal approach.', lawyers: 'Lawyers', staff: 'Support team', viewProfile: 'View profile' },
  de: { title: 'Unser Team', subtitle: 'Fachleute mit Erfahrung, Engagement und persönlicher Betreuung.', lawyers: 'Anwälte', staff: 'Unterstützungsteam', viewProfile: 'Profil ansehen' },
};
const l = labels[lang];
---

<Base
  title={`${l.title} — Izquierdo y de la Cueva`}
  description={l.subtitle + ' Abogados multilingües en Lanzarote desde 1986.'}
>
  <!-- Hero -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1920&q=50')] bg-cover bg-center"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/80 to-brand-900/50"></div>
    <div class="relative container-premium pt-36 pb-20 md:pt-44 md:pb-28">
      <span class="section-label text-white/40">{l.title}</span>
      <h1 class="text-heading text-white mt-5 max-w-3xl">{l.title}</h1>
      <p class="mt-5 text-lg md:text-xl text-white/60 max-w-2xl leading-relaxed">{l.subtitle}</p>
    </div>
  </section>

  <!-- Abogados -->
  <section class="bg-white py-section">
    <div class="container-premium">
      <div data-animate>
        <span class="section-label">{l.lawyers}</span>
        <div class="w-12 h-px bg-brand-500 mt-4 mb-12"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-animate>
        {lawyers.map((member) => (
          <a href={getLocalePath(`/equipo/${member.slug}/`, lang)} class="group block no-underline">
            <div class="relative overflow-hidden bg-brand-900">
              <!-- Foto -->
              <div class="aspect-[3/4] overflow-hidden">
                <img
                  src={member.photo}
                  alt={member.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  onerror="this.style.display='none';this.parentElement.classList.add('bg-gradient-to-br','from-brand-800','to-brand-900')"
                />
              </div>

              <!-- Overlay en hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-400"></div>

              <!-- Info siempre visible abajo -->
              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-7">
                <p class="text-white text-[22px] md:text-[24px] tracking-[-0.04em] leading-tight">{member.name}</p>
                <p class="text-white/55 text-sm mt-1.5">{member.role[lang]}</p>

                <!-- Aparece en hover -->
                <div class="mt-4 pt-4 border-t border-white/10 opacity-0 translate-y-3 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-400">
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {member.languages.map(lng => (
                      <span class="text-[11px] uppercase tracking-wider text-white/40 px-2 py-0.5 border border-white/10">{lng}</span>
                    ))}
                  </div>
                  <span class="inline-flex items-center gap-2 text-[#2596be] text-xs uppercase tracking-[0.2em]">
                    {l.viewProfile}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Equipo de apoyo -->
  <section class="bg-[#0E3548] py-section">
    <div class="container-premium">
      <div data-animate>
        <span class="text-[11px] uppercase tracking-[0.36em] text-[#2596be]/50">{l.staff}</span>
        <div class="w-12 h-px bg-[#2596be]/30 mt-4 mb-12"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-animate>
        {staff.map((member) => (
          <a href={getLocalePath(`/equipo/${member.slug}/`, lang)} class="group block no-underline">
            <div class="relative overflow-hidden border border-white/8 bg-white/[0.03] transition-all duration-400 hover:border-[#2596be]/30">
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={member.photo}
                  alt={member.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  onerror="this.style.display='none';this.parentElement.classList.add('bg-gradient-to-br','from-brand-800','to-brand-900')"
                />
              </div>
              <div class="p-6">
                <p class="text-white text-lg tracking-[-0.03em]">{member.name}</p>
                <p class="text-white/45 text-sm mt-1">{member.role[lang]}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {member.languages.map(lng => (
                    <span class="text-[11px] uppercase tracking-wider text-white/30 px-2 py-0.5 border border-white/8">{lng}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection lang={lang} />
</Base>
